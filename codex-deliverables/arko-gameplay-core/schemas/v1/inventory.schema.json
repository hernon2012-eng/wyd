{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arko-gameplay-core/v1/inventory.schema.json",
  "title": "ARKO Inventory Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["character_id", "slots"],
  "properties": {
    "character_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "slots": {"type": "array", "maxItems": 10000, "items": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["quantity"], "properties": {"quantity": {"const": 0}}}, {"type": "object", "additionalProperties": false, "required": ["item_id", "quantity"], "properties": {"item_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"}, "quantity": {"type": "integer", "minimum": 1}}}]}}
  }
}