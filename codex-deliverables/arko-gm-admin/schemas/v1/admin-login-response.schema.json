{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Admin login response",
  "description": "Generic successful-login response shape; token values in examples are non-secret placeholders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "access_token",
    "token_type",
    "expires_at",
    "principal"
  ],
  "properties": {
    "access_token": {
      "type": "string",
      "minLength": 1
    },
    "token_type": {
      "const": "Bearer"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "principal": {
      "$ref": "principal-profile.schema.json"
    }
  }
}
