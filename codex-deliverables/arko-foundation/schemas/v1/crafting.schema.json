{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arko.invalid/schemas/v1/crafting.schema.json",
  "title": "Crafting contract v1",
  "$defs": {
    "ingredient": {
      "type": "object",
      "required": ["item_ref", "quantity"],
      "properties": {
        "item_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "quantity": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": ["contract_version", "recipe_ref", "revision", "ingredients", "level_required", "station_ref", "duration_seconds", "result"],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "recipe_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision": { "type": "integer", "minimum": 1 },
        "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ingredient" } },
        "level_required": { "type": "integer", "minimum": 0 },
        "station_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "duration_seconds": { "type": "integer", "minimum": 0 },
        "result": { "$ref": "#/$defs/ingredient" },
        "demo_only": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["contract_version", "request_id", "recipe_ref", "quantity"],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipe_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    }
  }
}