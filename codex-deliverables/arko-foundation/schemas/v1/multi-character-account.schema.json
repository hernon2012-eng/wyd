{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arko.invalid/schemas/v1/multi-character-account.schema.json",
  "title": "Account character-slot proposal v1",
  "type": "object",
  "required": ["contract_version", "account_ref", "characters", "active_sessions"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "account_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
    "characters": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["character_ref", "progression", "revision"],
        "properties": {
          "character_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "progression": { "enum": ["Arch", "Mortal", "Celestial", "CelestialCS", "SCelestial"] },
          "revision": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "active_sessions": { "type": "integer", "minimum": 0, "maximum": 2 }
  },
  "additionalProperties": false
}